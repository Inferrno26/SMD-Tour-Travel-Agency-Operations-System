        <mxCell id="r_n" style="endArrow=block;endFill=0;dashed=1;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="notif" target="iface" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_p" style="endArrow=block;endFill=0;dashed=1;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" source="payment" target="iface" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

