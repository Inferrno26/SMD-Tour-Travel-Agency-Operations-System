<mxfile host="app.diagrams.net">
  <diagram name="Facade" id="facade">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Facade Pattern — Booking Engine over Booking Subsystems" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="200" y="30" width="1000" height="40" as="geometry"/>
        </mxCell>

        <!-- Customer (Client) -->
        <mxCell id="customer" value="Customer" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="customer_m" value="+ submitBooking()&#xa;+ cancelBooking()" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="customer">
          <mxGeometry y="28" width="200" height="72" as="geometry"/>
        </mxCell>

        <!-- BookingEngine (Facade) -->
        <mxCell id="facade" value="BookingEngine" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="facade_m" value="+ submitBookingRequest()&#xa;+ cancelBooking()&#xa;+ getBookingStatus()" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="facade">
          <mxGeometry y="28" width="280" height="132" as="geometry"/>
        </mxCell>

        <!-- Subsystems -->
        <mxCell id="catalog" value="CatalogService" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="catalog_m" value="+ checkAvailability()&#xa;+ updateCapacity()" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="catalog">
          <mxGeometry y="28" width="240" height="72" as="geometry"/>
        </mxCell>

        <mxCell id="policy" value="PolicyEngine" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="240" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="policy_m" value="+ validateCancellation()&#xa;+ checkEligibility()" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="policy">
          <mxGeometry y="28" width="240" height="72" as="geometry"/>
        </mxCell>

        <mxCell id="repo" value="BookingRepository" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="repo_m" value="+ create()&#xa;+ markCancelled()" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="repo">
          <mxGeometry y="28" width="240" height="72" as="geometry"/>
        </mxCell>

        <mxCell id="notif" value="NotificationService" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="560" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="notif_m" value="+ notifyCustomer()&#xa;+ send()" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="notif">
          <mxGeometry y="28" width="240" height="72" as="geometry"/>
        </mxCell>

        <!-- Relations -->
        <mxCell id="r_c" style="endArrow=open;endFill=0;dashed=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="customer" target="facade" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_cat" style="endArrow=open;endFill=0;html=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="facade" target="catalog" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_pol" style="endArrow=open;endFill=0;html=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="facade" target="policy" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_rep" style="endArrow=open;endFill=0;html=1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="facade" target="repo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_not" style="endArrow=open;endFill=0;html=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="facade" target="notif" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
