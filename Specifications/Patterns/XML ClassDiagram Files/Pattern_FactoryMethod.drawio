<mxfile host="app.diagrams.net">
  <diagram name="Factory Method" id="factory">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Factory Method Pattern — Booking Creation from Quotation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="200" y="30" width="1000" height="40" as="geometry"/>
        </mxCell>

        <!-- TravelAgent (Client) -->
        <mxCell id="agent" value="TravelAgent" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="agent_m" value="+ acceptQuotation(q)&#xa;+ rejectQuotation(q)" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="agent">
          <mxGeometry y="28" width="220" height="92" as="geometry"/>
        </mxCell>

        <!-- Quotation (Creator) -->
        <mxCell id="quot" value="Quotation" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="240" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="quot_a" value="- quotedPrice: Decimal&#xa;- validUntil: Date&#xa;- status: QuotationStatus" style="text;strokeColor=#000000;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="quot">
          <mxGeometry y="28" width="280" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="quot_m" value="+ prepare()&#xa;+ revise()&#xa;+ accept(): Booking&#xa;+ reject()&#xa;+ expire()" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="quot">
          <mxGeometry y="92" width="280" height="128" as="geometry"/>
        </mxCell>

        <!-- Booking (Product) -->
        <mxCell id="booking" value="Booking" style="shape=swimlane;startSize=28;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="booking_a" value="- bookingReference: String&#xa;- status: BookingStatus&#xa;- totalPrice: Decimal" style="text;strokeColor=#000000;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="booking">
          <mxGeometry y="28" width="280" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="booking_m" value="+ submit()&#xa;+ approve()&#xa;+ confirm()&#xa;+ cancel()&#xa;+ generateReference()" style="text;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="booking">
          <mxGeometry y="92" width="280" height="128" as="geometry"/>
        </mxCell>

        <!-- Relations -->
        <mxCell id="r_a_q" style="endArrow=open;endFill=0;dashed=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="agent" target="quot" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_q_b" value="«creates»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="quot" target="booking" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

